# Desarrollo local (Vite proxy → backend :3001)
# VITE_API_URL=http://localhost:3001
#
# Producción (Cloudflare Pages): no hace falta VITE_API_URL.
# Las peticiones van a /api/v1 en el mismo dominio → Worker WAF → Render.
#
# Video loop del hero (home): frontend/public/videos/intro-mobile.mp4
# VITE_INTRO_VIDEO_URL=https://...
# URL pública del sitio (misma que Cloudflare Pages) para que los QR embebidos en /credencial apunten al host correcto
# URL pública del sitio (SEO: canonical, Open Graph, sitemap). Debe coincidir con tu dominio en producción.
# VITE_PUBLIC_APP_URL=https://barcelona-chalco.pages.dev
# VITE_APP_NAME=Academia Barcelona
#
# Mapas embebidos en fichas de partido (solo la URL del src del iframe de Google Maps, https://www.google.com/maps/embed?pb=...)
# VITE_VENUE_WALMART_MAP_EMBED_URL=
# VITE_VENUE_ATLAS_MAP_EMBED_URL=
# VITE_VENUE_CANCHAS100_MAP_EMBED_URL=
#
# Web Push: las claves VAPID van en el backend (Render). El front pide la pública a GET /push/public/vapid-key.
